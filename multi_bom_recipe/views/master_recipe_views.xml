<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_master_recipe_tree" model="ir.ui.view">
        <field name="name">master.recipe.tree</field>
        <field name="model">master.recipe</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="product_id"/>
                <field name="company_id"/>
            </list>
        </field>
    </record>

    <record id="view_master_recipe_form" model="ir.ui.view">
        <field name="name">master.recipe.form</field>
        <field name="model">master.recipe</field>
        <field name="arch" type="xml">
            <form string="Master Recipe">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_boms"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-sitemap">
                            <field name="bom_counts" string="BOMs" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="company_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Main Components">
                            <field name="main_component_lines">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="product_qty" digits="[12, 4]"/>
                                    <field name="product_uom_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Sales Channels">
                            <field name="sales_channel_ids">
                                <list editable="bottom">
                                    <field name="channel_id"/>
                                    <field name="product_id"/>
                                    <field name="product_qty" digits="[12, 4]"/>
                                    <field name="bom_id" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_master_recipe" model="ir.actions.act_window">
        <field name="name">Master Recipes</field>
        <field name="res_model">master.recipe</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem
        id="menu_master_recipe"
        name="Master Recipes"
        parent="point_of_sale.menu_point_config_product"
        action="action_master_recipe"
        sequence="10"
    />
</odoo>
