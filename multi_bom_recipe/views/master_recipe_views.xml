<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_master_recipe_tree" model="ir.ui.view">
        <field name="name">master.recipe.tree</field>
        <field name="model">master.recipe</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="product_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </tree>
        </field>
    </record>

    <record id="view_master_recipe_form" model="ir.ui.view">
        <field name="name">master.recipe.form</field>
        <field name="model">master.recipe</field>
        <field name="arch" type="xml">
            <form string="Master Recipe">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_boms"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-sitemap">
                            <field name="bom_counts" string="BOMs" widget="statinfo"/>
                        </button>
                    </div>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="product_id"/>
                            <field name="recipe_channel_ids" widget="many2many_tags"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Main Components">
                            <field name="main_component_lines">
                                <tree editable="bottom">
                                    <field name="product_id"/>
                                    <field name="product_qty" digits="[12, 4]"/>
                                    <field name="product_uom_category_id" column_invisible="True"/>
                                    <field name="product_uom_id"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Channel Components">
                            <field name="sales_channel_ids">
                                <tree editable="bottom">
                                    <field name="channel_id"/>
                                    <field name="product_id"/>
                                    <field name="product_qty" digits="[12, 4]"/>
                                    <field name="product_uom_id" readonly="True"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_master_recipe" model="ir.actions.act_window">
        <field name="name">Master Recipes</field>
        <field name="res_model">master.recipe</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="menu_master_recipe"
        name="Master Recipes"
        parent="point_of_sale.pos_menu_products_configuration"
        action="action_master_recipe"
        sequence="10"
    />
</odoo>
